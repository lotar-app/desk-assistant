{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "desk-v2-foundation-dev",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-23",
  "preview_urls": false,
  "vars": {
    "DESK_SYSTEM_NAME": "desk-v2",
    "DESK_ENVIRONMENT": "v2-development",
    "DESK_SCHEMA_FAMILY": "desk-v2-foundation",
    "DESK_REQUIRED_MIGRATION": "0001_foundation.sql"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DESK_V2_DB",
      "database_name": "desk-v2-foundation-dev",
      "database_id": "e2b252a0-ec15-48a8-bcd6-aed6d49427a3",
      "preview_database_id": "desk-v2-foundation-local",
      "migrations_dir": "migrations",
      "migrations_table": "d1_migrations"
    }
  ]
}
